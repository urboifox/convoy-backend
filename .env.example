PORT=8080
DATABASE_URL=postgres://convoy:convoy@localhost:5432/convoy?sslmode=disable
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=720h
WS_PING_INTERVAL=25s
WS_READ_TIMEOUT=60s
WS_WRITE_TIMEOUT=10s

# LiveKit voice (optional; voice token route returns 503 if unset)
LIVEKIT_URL=wss://livekit.arabic4u.org
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Admin dashboard (set both to enable /admin)
ADMIN_PASSWORD=
ADMIN_COOKIE_SECRET=

# Optional — only required when your Expo account has Enhanced Push Security
# enabled. See https://docs.expo.dev/push-notifications/sending-notifications/#access-tokens
EXPO_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# OAuth — Google
# -----------------------------------------------------------------------------
# Comma-separated list of OAuth 2.0 client IDs we accept ID tokens from.
# MUST include every client id the mobile app may present (iOS, Android, Web).
# An ID token whose `aud` claim isn't in this list is rejected with 401.
# Leave empty to disable /auth/google entirely (the mobile button hides itself).
GOOGLE_CLIENT_IDS=

# -----------------------------------------------------------------------------
# OAuth — Apple
# -----------------------------------------------------------------------------
# Comma-separated list of accepted `aud` values for Apple ID tokens. For an
# iOS-only app this is just your bundle identifier:
#   APPLE_CLIENT_IDS=dev.urboifox.convoy
# If you later add a web flow with a separate Services ID, include that too.
APPLE_CLIENT_IDS=

# -----------------------------------------------------------------------------
# Privacy policy (served at /policy)
# -----------------------------------------------------------------------------
# Required: if PRIVACY_CONTACT_EMAIL is empty the /policy route is disabled
# and the "Privacy policy" link inside the app 404s.
PRIVACY_CONTACT_EMAIL=
# Optional. Human-readable date shown in the policy header. Defaults to
# today's date if unset (formatted "January 2, 2006").
PRIVACY_EFFECTIVE_DATE=
# Optional. Shown in the policy header instead of "Convoy".
APP_NAME=Convoy
